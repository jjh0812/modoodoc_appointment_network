# =========================================================
# Database
#
# Local development example:
# PostgreSQL exposed on localhost:5434
#
# Docker Compose overrides DATABASE_URL automatically,
# so this value is mainly for local non-Docker execution.
# =========================================================

DATABASE_URL=postgresql+psycopg://modoodoc:YOUR_PASSWORD@127.0.0.1:5434/modoodoc


# =========================================================
# OpenAI
#
# Required only for OpenAI integration tests / agent usage.
# Do not commit a real API key.
# =========================================================

OPENAI_API_KEY=YOUR_OPENAI_API_KEY


# =========================================================
# Public MCP
#
# Optional.
#
# Set this only when the public search-only MCP server
# is exposed through an HTTPS endpoint.
# =========================================================

PUBLIC_MCP_URL=https://YOUR_PUBLIC_MCP_URL